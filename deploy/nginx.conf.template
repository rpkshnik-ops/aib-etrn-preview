# Generated by deploy/render_nginx.py; install to sites-available/aib-etrn.
# Included inside nginx's http {} block.
limit_req_zone $binary_remote_addr zone=aib_leads:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    root /srv/aib-etrn/current;
    index index.html;
    charset utf-8;
    server_tokens off;
    client_max_body_size 16k;

    # Do not log URLs/UTM or applicant data; errors remain in the nginx error log.
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # inline styles are used only for CSS reveal variables; scripts stay external.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru https://mc.yandex.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru https://mc.yandex.com; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; frame-src https://mc.yandex.ru https://mc.yandex.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml;

    location = /api/leads {
        limit_req zone=aib_leads burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:8081;
    }
    location /legal/ {
        alias /srv/aib-etrn/legal/;
        autoindex off;
        expires -1;
    }
    location ~ /\. {
        deny all;
    }
    location ~* \.(?:css|js|png|webp|svg|ico)$ {
        expires 1h;
        try_files $uri =404;
    }
    location / {
        expires -1;
        try_files $uri $uri/ =404;
    }
    error_page 404 /404.html;
}
